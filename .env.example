# Copie para .env (que não é versionado) e troque as senhas:
#   cp .env.example .env
# Use apenas letras e números nas senhas (elas entram na URL de conexão).
# Usado SOMENTE na execução local. Na nuvem, as senhas ficam no Secret Manager.

MONGO_ROOT_PASSWORD=troque-senha-root-local
MONGO_APP_PASSWORD=troque-senha-app-local

# Porta local da interface (padrão 80)
HTTP_PORT=80
