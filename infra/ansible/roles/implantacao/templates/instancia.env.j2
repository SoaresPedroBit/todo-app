# Gerado pelo Ansible (implantar.yml). Não editar à mão.
export TODO_CLOUD=gcp TODO_ROLE={{ papel }} TODO_PROJECT={{ projeto }}
export TODO_REGISTRY_HOST={{ registro }}
export TODO_INSTANCE_ID={{ tf[papel ~ '_instance_id'].value }}
export TODO_PRIVATE_IP={{ tf[papel ~ '_private_ip'].value }}
export TODO_SECRET_APP={{ segredo_app }}
{% if papel == 'app' %}
export TODO_PUBLIC_IP={{ tf.app_public_ip.value }}
export TODO_DB_HOST={{ tf.db_private_ip.value }}
export TODO_SITE_ADDRESS={{ tf.site_address.value }}
export TODO_TLS_DIRETIVA='# certificado publico automatico'
{% else %}
export TODO_MONGO_ALLOWED_FROM={{ tf.app_private_ip.value }}
export TODO_SECRET_ROOT={{ segredo_root }}
export TODO_BACKUP_BUCKET={{ tf.backup_bucket.value }}
{% endif %}
